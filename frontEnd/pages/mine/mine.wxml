<!--pages/mine/mine.wxml-->
<view class="mine-container">
  <!-- 用户信息卡片 -->
  <view class="profile-card">
    <view class="avatar-wrapper">
      <text class="avatar-icon">👤</text>
    </view>
  </view>

  <!-- 充值卡片 -->
  <view class="recharge-card">
    <view class="left-info">
      <text class="title">充值获取积分</text>
      <text class="desc">联系客服充值积分</text>
    </view>
    <button class="action-btn" bindtap="recharge">充值积分</button>
  </view>

  <!-- 统计数据 -->
  <view class="stats-grid">
    <view class="stat-item">
      <text class="value">{{pointsBalance}}</text>
      <text class="label">剩余积分</text>
    </view>
    <view class="stat-item">
      <text class="value">{{mockInterviewCount}}</text>
      <text class="label">模拟面试</text>
    </view>
    <view class="stat-item">
      <text class="value">{{resumeOptimizationCount}}</text>
      <text class="label">简历优化</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="function-section">
    <text class="section-title">常用功能</text>
    
    <view class="menu-list">
      <view class="menu-item" bindtap="goToResumeMgr">
        <view class="icon-box" style="background-color:#fef3c7; color:#d97706;">📁</view>
        <text class="menu-title">我的简历管理</text>
        <text class="menu-desc">管理</text>
        <text class="arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToReports">
        <view class="icon-box" style="background-color:#dbeafe; color:#2563eb;">📝</view>
        <text class="menu-title">面试记录</text>
        <text class="menu-desc">查看历史</text>
        <text class="arrow">›</text>
      </view>

      <view class="menu-item" bindtap="recharge">
        <view class="icon-box" style="background-color:#e0f2fe; color:#0284c7;">💎</view>
        <text class="menu-title">充值积分</text>
        <text class="menu-desc">需联系客服</text>
        <text class="arrow">›</text>
      </view>

      <view class="menu-item" bindtap="contactService">
        <view class="icon-box" style="background-color:#dcfce7; color:#15803d;">📞</view>
        <text class="menu-title">联系客服</text>
        <text class="menu-desc">在线支持</text>
        <text class="arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToSettings">
        <view class="icon-box" style="background-color:#f1f5f9; color:#64748b;">⚙️</view>
        <text class="menu-title">设置中心</text>
        <text class="menu-desc">系统管理</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
