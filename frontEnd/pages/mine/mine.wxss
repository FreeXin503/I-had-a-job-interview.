/* pages/mine/mine.wxss */
.mine-container {
  padding: 32rpx 40rpx;
  min-height: 100vh;
  background-color: #f8fafc;
}

.profile-card {
  display: flex;
  justify-content: center;
  padding: 64rpx 0;
}

.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(37, 99, 235, 0.3);
}

.avatar-icon {
  font-size: 80rpx;
}

.recharge-card {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48rpx;
  box-shadow: 0 20rpx 50rpx rgba(37, 99, 235, 0.2);
}

.recharge-card .left-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #ffffff;
}

.recharge-card .title {
  font-size: 32rpx;
  font-weight: 700;
}

.recharge-card .desc {
  font-size: 24rpx;
  opacity: 0.8;
}

.recharge-card .action-btn {
  background: #ffffff;
  color: #2563eb;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.stat-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stat-item .value {
  font-size: 48rpx;
  font-weight: 800;
  color: #2563eb;
}

.stat-item .label {
  font-size: 22rpx;
  color: #64748b;
}

.function-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
  display: block;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-item {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.menu-item .icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.menu-item .menu-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.menu-item .menu-desc {
  font-size: 22rpx;
  color: #64748b;
}

.menu-item .arrow {
  font-size: 48rpx;
  color: #cbd5e1;
}
