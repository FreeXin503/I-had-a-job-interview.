/* pages/report/report.wxss */
.report-container {
  padding: 32rpx 40rpx 200rpx;
  min-height: 100vh;
}

.score-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 48rpx;
  display: flex;
  align-items: center;
  gap: 40rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 48rpx;
}

.score-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(37, 99, 235, 0.3);
}

.score-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.score-unit {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
  margin-top: 8rpx;
}

.score-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rating-badge {
  background: rgba(245, 158, 11, 0.1);
  color: #d97706;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 800;
  align-self: flex-start;
}

.duration {
  font-size: 22rpx;
  color: #64748b;
}

.compete {
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.eval-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.eval-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.eval-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.eval-title::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #2563eb;
}

.eval-content {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.question-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.question-badge {
  background: #eff6ff;
  color: #2563eb;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: inline-block;
  margin-bottom: 16rpx;
}

.question-text {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 600;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}

.divider {
  height: 2rpx;
  background: #e2e8f0;
  margin: 24rpx 0;
}

.analysis-section {
  margin-bottom: 24rpx;
}

.analysis-section:last-child {
  margin-bottom: 0;
}

.analysis-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 12rpx;
}

.analysis-content {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  display: block;
}

.analysis-content.example {
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid #2563eb;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 40rpx;
  background: #ffffff;
  border-top: 2rpx solid #e2e8f0;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: #ffffff;
  border: none;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(37, 99, 235, 0.3);
}

.btn-secondary {
  flex: 1;
  background: #ffffff;
  color: #2563eb;
  border: 3rpx solid #2563eb;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 32rpx;
}
