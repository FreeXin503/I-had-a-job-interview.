/* pages/interview/interview.wxss */
.interview-container {
  min-height: 100vh;
  background: #111827;
  color: #ffffff;
  display: flex;
  flex-direction: column;
}

.interview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 40rpx;
}

.ai-tag {
  font-size: 22rpx;
  opacity: 0.6;
}

.hangup-btn {
  background-color: rgba(239, 68, 68, 0.2);
  color: #ef4444;
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 2rpx solid rgba(239, 68, 68, 0.3);
}

.video-pane {
  position: relative;
  margin: 0 40rpx;
  border-radius: 56rpx;
  overflow: hidden;
  height: 920rpx;
  box-shadow: 0 30rpx 60rpx rgba(0, 0, 0, 0.5);
}

.video-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.avatar-emoji {
  font-size: 160rpx;
  margin-bottom: 24rpx;
}

.interviewer-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%);
}

.video-status-badge {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #10b981;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.video-timer {
  position: absolute;
  bottom: 32rpx;
  right: 32rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-family: monospace;
}

.chat-area {
  flex: 1;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.dialogue-box {
  flex: 1;
  max-height: 320rpx;
}

.chat-bubble {
  max-width: 85%;
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.chat-bubble.ai {
  background-color: #1f2937;
  color: #ffffff;
  border-bottom-left-radius: 8rpx;
  margin-right: auto;
}

.chat-bubble.user {
  background-color: #2563eb;
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
  margin-left: auto;
}

.voice-waves {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.wave-bar {
  width: 6rpx;
  height: 8rpx;
  background-color: #2563eb;
  border-radius: 4rpx;
  transition: height 0.1s ease;
}

.voice-waves.active .wave-bar {
  background-color: #60a5fa;
  animation: wave-bounce 1s ease-in-out infinite alternate;
}

.voice-waves.active .wave-bar:nth-child(1) { animation-delay: 0.1s; }
.voice-waves.active .wave-bar:nth-child(2) { animation-delay: 0.3s; }
.voice-waves.active .wave-bar:nth-child(3) { animation-delay: 0.5s; }
.voice-waves.active .wave-bar:nth-child(4) { animation-delay: 0.2s; }
.voice-waves.active .wave-bar:nth-child(5) { animation-delay: 0.4s; }
.voice-waves.active .wave-bar:nth-child(6) { animation-delay: 0.6s; }
.voice-waves.active .wave-bar:nth-child(7) { animation-delay: 0.1s; }
.voice-waves.active .wave-bar:nth-child(8) { animation-delay: 0.3s; }

@keyframes wave-bounce {
  from { height: 8rpx; }
  to { height: 64rpx; }
}

.action-buttons {
  display: flex;
  justify-content: center;
}

.record-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: #ffffff;
  border: none;
  padding: 32rpx 64rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 64rpx;
  box-shadow: 0 8rpx 30rpx rgba(37, 99, 235, 0.3);
}

.record-btn.recording {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  animation: pulse-scale 1s infinite;
}

@keyframes pulse-scale {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* 2D真人面试官样式 */
.interviewer-avatar-container {
  width: 100%;
  height: 100%;
  position: relative;
  background: #111827; /* 极暗科技底色 */
  overflow: hidden;
}

/* 极美毛玻璃与彩色氛围灯光底层 */
.frosted-glass-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #030712;
  z-index: 1;
  overflow: hidden;
}

.office-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.65;
  filter: blur(28rpx); /* 给办公室底图上高强度模糊以形成极其纯正自然的毛玻璃效果 */
  transform: scale(1.1); /* 稍微放大防止边缘发白漏边 */
}

.frosted-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 23, 42, 0.45); /* 深色高质感半透明磨砂面遮罩 */
  z-index: 1;
}

/* 氛围发光霓虹（毛玻璃质感底物） */
.ambient-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(140rpx);
  opacity: 0.45;
  mix-blend-mode: screen;
}

.glow-1 {
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, #4f46e5 0%, rgba(79, 70, 229, 0) 70%);
  top: -80rpx;
  left: -80rpx;
}

.glow-2 {
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, #db2777 0%, rgba(219, 39, 119, 0) 70%);
  bottom: -100rpx;
  right: -80rpx;
}

.interviewer-image-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  border-radius: 56rpx;
  overflow: hidden;
}

.interviewer-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.interviewer-image.base {
  z-index: 2;
}

.interviewer-image.overlay {
  z-index: 3;
  /* 运用 GPU 硬件加速的 0.08s 极致线性过渡，营造微米级唇形无缝渐变 */
  transition: opacity 0.08s linear;
  will-change: opacity;
}

.interviewer-info-overlay {
  position: absolute;
  bottom: 32rpx;
  left: 32rpx;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  z-index: 9;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 32rpx 0 rgba(0, 0, 0, 0.3);
}

.interviewer-name-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

.switch-interviewer-btn {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  background: rgba(37, 99, 235, 0.45);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  z-index: 12;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.switch-interviewer-btn .switch-icon {
  font-size: 24rpx;
}

.switch-interviewer-btn .switch-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
}

.switch-btn-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ==========================================
   🚀 新增四大惊艳升级功能之高级 CSS 动画样式
   ========================================== */

/* 1. 优化动态声波过渡效果 */
.voice-waves.active .wave-bar {
  background-color: #60a5fa;
  box-shadow: 0 0 8rpx rgba(96, 165, 250, 0.5);
  animation: none; /* 禁用静态 CSS 循环，完全由 JS 动态计算的 waveHeights 驱动 */
  transition: height 0.06s linear; /* 微秒级高度过渡，极其润滑 */
  will-change: height;
}

/* 2. 玻璃磨砂面试进度关卡轴 */
.timeline-container {
  position: absolute;
  top: 105rpx; /* 避开通话状态徽章与切换角色按钮 */
  left: 32rpx;
  right: 32rpx;
  z-index: 15;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(24rpx) saturate(180%);
  -webkit-backdrop-filter: blur(24rpx) saturate(180%);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.timeline-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  transition: all 0.3s ease;
  opacity: 0.35;
}

.timeline-step.active {
  opacity: 1;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4b5563;
  border: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.timeline-step.active .step-dot {
  background: #ffffff;
  border-color: #3b82f6;
  box-shadow: 0 0 12rpx #3b82f6;
  transform: scale(1.2);
}

.step-title {
  font-size: 18rpx;
  font-weight: 600;
  color: #9ca3af;
  transition: all 0.3s ease;
}

.timeline-step.active .step-title {
  color: #3b82f6;
  text-shadow: 0 0 4rpx rgba(59, 130, 246, 0.3);
}

.timeline-line {
  height: 4rpx;
  background: #374151;
  flex: 1;
  margin: 0 -12rpx;
  margin-bottom: 24rpx; /* 对齐圆点中心线 */
  transition: all 0.3s ease;
}

.timeline-line.active {
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  box-shadow: 0 0 4rpx #3b82f6;
}

/* 3. 极美背景炫彩呼吸漂浮粒子 */
.particle {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
  opacity: 0.25;
  mix-blend-mode: screen;
  animation: float-particle 15s ease-in-out infinite alternate;
  z-index: 2;
}

.p-1 {
  width: 40rpx;
  height: 40rpx;
  background: radial-gradient(circle, #3b82f6 0%, rgba(59, 130, 246, 0) 80%);
  top: 15%;
  left: 20%;
  animation-duration: 18s;
}

.p-2 {
  width: 60rpx;
  height: 60rpx;
  background: radial-gradient(circle, #db2777 0%, rgba(219, 39, 119, 0) 80%);
  top: 45%;
  right: 15%;
  animation-duration: 22s;
  animation-delay: -3s;
}

.p-3 {
  width: 30rpx;
  height: 30rpx;
  background: radial-gradient(circle, #10b981 0%, rgba(16, 185, 129, 0) 80%);
  bottom: 25%;
  left: 15%;
  animation-duration: 14s;
  animation-delay: -5s;
}

.p-4 {
  width: 50rpx;
  height: 50rpx;
  background: radial-gradient(circle, #f59e0b 0%, rgba(245, 158, 11, 0) 80%);
  bottom: 15%;
  right: 35%;
  animation-duration: 25s;
}

@keyframes float-particle {
  0% {
    transform: translateY(0) translateX(0) scale(1);
    opacity: 0.15;
  }
  50% {
    transform: translateY(-40rpx) translateX(30rpx) scale(1.2);
    opacity: 0.35;
  }
  100% {
    transform: translateY(20rpx) translateX(-20rpx) scale(0.9);
    opacity: 0.20;
  }
}

/* 4. AI 即时评估 HUD 仪表盘 */
.hud-dashboard {
  display: none;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 32rpx;
  padding: 24rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  flex-direction: column;
  gap: 20rpx;
  animation: slide-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  will-change: transform, opacity;
}

.hud-dashboard.visible {
  display: flex;
}

@keyframes slide-up {
  from {
    transform: translateY(30rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.hud-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hud-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hud-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9ca3af;
  letter-spacing: 1rpx;
}

.hud-value-text {
  font-size: 24rpx;
  font-family: monospace;
  font-weight: bold;
  color: #3b82f6;
  text-shadow: 0 0 8rpx rgba(59, 130, 246, 0.4);
}

.hud-bar-wrapper {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 5rpx;
  overflow: hidden;
  position: relative;
}

.hud-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.1s linear;
  will-change: width;
}

.hud-bar-fill.fluency {
  background: linear-gradient(90deg, #3b82f6, #60a5fa);
  box-shadow: 0 0 10rpx rgba(59, 130, 246, 0.5);
}

.hud-bar-fill.tech {
  background: linear-gradient(90deg, #10b981, #34d399);
  box-shadow: 0 0 10rpx rgba(16, 185, 129, 0.5);
}

.hud-bar-fill.logic {
  background: linear-gradient(90deg, #db2777, #f472b6);
  box-shadow: 0 0 10rpx rgba(219, 39, 119, 0.5);
}

