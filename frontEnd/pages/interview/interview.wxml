<!--pages/interview/interview.wxml-->
<view class="interview-container">
  <!-- 顶部状态栏 -->
  <view class="interview-header">
    <view class="ai-tag">内容由AI实时生成</view>
    <button class="hangup-btn" bindtap="endInterview">结束面试</button>
  </view>

  <!-- 视频区域 -->
  <view class="video-pane">
    <!-- 2D写实形象展示 -->
    <view class="interviewer-avatar-container">
      <!-- 极美毛玻璃与环境氛围背景图底层 -->
      <view class="frosted-glass-backdrop">
        <view class="ambient-glow glow-1"></view>
        <view class="ambient-glow glow-2"></view>
      </view>

      <!-- 女生面试官 (双层重叠 5 帧平滑渐变嘴型) -->
      <view wx:if="{{activeInterviewer === 'female'}}" class="interviewer-image-wrapper">
        <image 
          class="interviewer-image base" 
          src="/assets/avatars/female_closed.jpg" 
          mode="aspectFill"
        />
        <image 
          class="interviewer-image overlay" 
          src="/assets/avatars/female_open.jpg" 
          mode="aspectFill"
          style="opacity: {{speakOpacity || 0.0}};"
        />
      </view>

      <!-- 男生面试官 (双层重叠 5 帧平滑渐变嘴型) -->
      <view wx:if="{{activeInterviewer === 'male'}}" class="interviewer-image-wrapper">
        <image 
          class="interviewer-image base" 
          src="/assets/avatars/male_closed.jpg" 
          mode="aspectFill"
        />
        <image 
          class="interviewer-image overlay" 
          src="/assets/avatars/male_open.jpg" 
          mode="aspectFill"
          style="opacity: {{speakOpacity || 0.0}};"
        />
      </view>

      <!-- 面试官姓名及浮层 -->
      <view class="interviewer-info-overlay">
        <text class="interviewer-name-text">{{activeInterviewer === 'female' ? femaleName : maleName}}</text>
      </view>
    </view>

    <!-- 切换角色按钮 -->
    <view class="switch-interviewer-btn" bindtap="switchInterviewer" hover-class="switch-btn-hover">
      <text class="switch-icon">🔄</text>
      <text class="switch-text">换面试官</text>
    </view>
    
    <view class="video-overlay"></view>
    
    <view class="video-status-badge">
      <view class="status-dot"></view>
      <text>通话中</text>
    </view>
    
    <view class="video-timer">{{timerText}}</view>
  </view>

  <!-- 对话区域 -->
  <view class="chat-area">
    <scroll-view class="dialogue-box" scroll-y scroll-into-view="msg-{{dialogues.length - 1}}">
      <view class="chat-bubble {{item.type}}" wx:for="{{dialogues}}" wx:key="index" id="msg-{{index}}">
        <text>{{item.text}}</text>
      </view>
    </scroll-view>

    <!-- 语音波形 -->
    <view class="voice-waves {{waveActive ? 'active' : ''}}">
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
      <view class="wave-bar"></view>
    </view>

    <!-- 录音按钮 -->
    <view class="action-buttons">
      <button 
        class="record-btn {{isRecording ? 'recording' : ''}}" 
        bindtouchstart="startRecording" 
        bindtouchend="stopRecording"
        disabled="{{isAISpeaking}}"
      >
        <text wx:if="{{!isRecording}}">🎤 按住说话</text>
        <text wx:else>🔴 松开发送</text>
      </button>
    </view>
  </view>
</view>
