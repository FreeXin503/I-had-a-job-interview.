<!--pages/interview/interview.wxml-->
<view class="interview-container">
  <!-- 顶部状态栏 -->
  <view class="interview-header">
    <view class="ai-tag">内容由AI实时生成</view>
    <button class="hangup-btn" bindtap="endInterview">结束面试</button>
  </view>

  <!-- 视频区域 -->
  <view class="video-pane">
    <!-- 🚀 升级功能二：高透毛玻璃面试关卡进度轴 -->
    <view class="timeline-container" wx:if="{{showTimeline}}">
      <view class="timeline-step {{activeStage >= 0 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text class="step-title">自我介绍</text>
      </view>
      <view class="timeline-line {{activeStage >= 1 ? 'active' : ''}}"></view>
      <view class="timeline-step {{activeStage >= 1 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text class="step-title">技术基础</text>
      </view>
      <view class="timeline-line {{activeStage >= 2 ? 'active' : ''}}"></view>
      <view class="timeline-step {{activeStage >= 2 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text class="step-title">项目深挖</text>
      </view>
      <view class="timeline-line {{activeStage >= 3 ? 'active' : ''}}"></view>
      <view class="timeline-step {{activeStage >= 3 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text class="step-title">压力测试</text>
      </view>
      <view class="timeline-line {{activeStage >= 4 ? 'active' : ''}}"></view>
      <view class="timeline-step {{activeStage >= 4 ? 'active' : ''}}">
        <view class="step-dot"></view>
        <text class="step-title">自由提问</text>
      </view>
    </view>

    <!-- 2D写实形象展示 -->
    <view class="interviewer-avatar-container">
      <!-- 极美毛玻璃与环境氛围背景图底层 (公司办公室毛玻璃背景) -->
      <view class="frosted-glass-backdrop">
        <image class="office-bg-image" src="/assets/avatars/office_bg.jpg" mode="aspectFill" />
        <view class="frosted-overlay"></view>
        <view class="ambient-glow glow-1"></view>
        <view class="ambient-glow glow-2"></view>
        <!-- 🚀 升级功能四：炫彩微动呼吸漂浮粒子 -->
        <view class="particle p-1"></view>
        <view class="particle p-2"></view>
        <view class="particle p-3"></view>
        <view class="particle p-4"></view>
      </view>

      <!-- 女生面试官 (双层重叠 10 帧平滑渐变嘴型) -->
      <view wx:if="{{activeInterviewer === 'female'}}" class="interviewer-image-wrapper">
        <image 
          class="interviewer-image base" 
          src="/assets/avatars/female_closed.jpg" 
          mode="aspectFill"
        />
        <image 
          class="interviewer-image overlay" 
          src="/assets/avatars/female_open.jpg" 
          mode="aspectFill"
          style="opacity: {{speakOpacity || 0.0}};"
        />
      </view>

      <!-- 男生面试官 (双层重叠 10 帧平滑渐变嘴型) -->
      <view wx:if="{{activeInterviewer === 'male'}}" class="interviewer-image-wrapper">
        <image 
          class="interviewer-image base" 
          src="/assets/avatars/male_closed.jpg" 
          mode="aspectFill"
        />
        <image 
          class="interviewer-image overlay" 
          src="/assets/avatars/male_open.jpg" 
          mode="aspectFill"
          style="opacity: {{speakOpacity || 0.0}};"
        />
      </view>

      <!-- 面试官姓名及浮层 -->
      <view class="interviewer-info-overlay">
        <text class="interviewer-name-text">{{activeInterviewer === 'female' ? femaleName : maleName}}</text>
      </view>
    </view>

    <!-- 切换角色按钮 -->
    <view class="switch-interviewer-btn" bindtap="switchInterviewer" hover-class="switch-btn-hover">
      <text class="switch-icon">🔄</text>
      <text class="switch-text">换面试官</text>
    </view>
    
    <view class="video-overlay"></view>
    
    <view class="video-status-badge">
      <view class="status-dot"></view>
      <text>通话中</text>
    </view>
    
    <view class="video-timer">{{timerText}}</view>
  </view>

  <!-- 对话区域 -->
  <view class="chat-area">
    <!-- 🚀 升级功能三：AI 瞬时反馈 HUD 科技跑分仪表盘 -->
    <view class="hud-dashboard {{hudScores.fluency > 0 ? 'visible' : ''}}">
      <view class="hud-item">
        <view class="hud-info">
          <text class="hud-label">🗣️ 表达流畅</text>
          <text class="hud-value-text">{{hudScores.fluency}}%</text>
        </view>
        <view class="hud-bar-wrapper">
          <view class="hud-bar-fill fluency" style="width: {{hudScores.fluency}}%"></view>
        </view>
      </view>
      
      <view class="hud-item">
        <view class="hud-info">
          <text class="hud-label">💻 核心匹配</text>
          <text class="hud-value-text">{{hudScores.techMatch}}%</text>
        </view>
        <view class="hud-bar-wrapper">
          <view class="hud-bar-fill tech" style="width: {{hudScores.techMatch}}%"></view>
        </view>
      </view>
      
      <view class="hud-item">
        <view class="hud-info">
          <text class="hud-label">🧠 逻辑严谨</text>
          <text class="hud-value-text">{{hudScores.logic}}%</text>
        </view>
        <view class="hud-bar-wrapper">
          <view class="hud-bar-fill logic" style="width: {{hudScores.logic}}%"></view>
        </view>
      </view>
    </view>

    <!-- 问答对话列表 -->
    <scroll-view class="dialogue-box" scroll-y scroll-into-view="msg-{{dialogues.length - 1}}">
      <view class="chat-bubble {{item.type}}" wx:for="{{dialogues}}" wx:key="index" id="msg-{{index}}">
        <text>{{item.text}}</text>
      </view>
    </scroll-view>

    <!-- 🚀 升级功能一：绑定动态高度与能量起伏的拟真声波 -->
    <view class="voice-waves {{waveActive || isAISpeaking ? 'active' : ''}}">
      <view class="wave-bar" style="height: {{waveHeights[0] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[1] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[2] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[3] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[4] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[5] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[6] || 20}}%;"></view>
      <view class="wave-bar" style="height: {{waveHeights[7] || 20}}%;"></view>
    </view>

    <!-- 录音与操作按键区 -->
    <view class="action-buttons">
      <button 
        class="record-btn {{isRecording ? 'recording' : ''}}" 
        bindtouchstart="startRecording" 
        bindtouchend="stopRecording"
        disabled="{{isAISpeaking}}"
      >
        <text wx:if="{{!isRecording}}">🎤 按住说话</text>
        <text wx:else>🔴 松开发送</text>
      </button>
    </view>
  </view>
</view>
