/* pages/home/home.wxss */
.home-container {
  padding: 32rpx 40rpx;
  min-height: 100vh;
}

.home-header {
  margin-bottom: 48rpx;
}

.badge-engine {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #eff6ff;
  color: #2563eb;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.badge-engine .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #2563eb;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.home-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.25;
  margin-bottom: 16rpx;
}

.home-subtitle {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.5;
  white-space: pre-line;
}

.interviewer-preview-card {
  position: relative;
  height: 520rpx;
  border-radius: 48rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 48rpx;
}

.interviewer-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.avatar-large {
  font-size: 200rpx;
  margin-bottom: 24rpx;
}

.ai-label {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.live-tag {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(16rpx);
  color: #ffffff;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.online-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 16rpx #10b981;
  animation: beacon 1.5s infinite;
}

@keyframes beacon {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.mic-indicator {
  position: absolute;
  bottom: 32rpx;
  right: 32rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.mic-emoji {
  font-size: 40rpx;
}

.home-main-cta-box {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.home-primary-cta-btn {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: #ffffff;
  border: none;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(37, 99, 235, 0.3);
}

.home-secondary-link-btn {
  background: #ffffff;
  color: #2563eb;
  border: 2rpx solid #e2e8f0;
  padding: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 32rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.link-all {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
}

.arrow {
  font-size: 32rpx;
}

.recent-records-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recent-record-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 20rpx 50rpx -10rpx rgba(0, 0, 0, 0.05);
}

.left-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.job-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.details {
  font-size: 22rpx;
  color: #64748b;
}

.score-badge {
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
  white-space: pre-line;
}
